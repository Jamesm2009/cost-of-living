# Copy to .env.local for local development.
# In production, set these in Vercel → Settings → Environment Variables.
# NEVER commit .env.local — it is gitignored.

# Upstash Redis (console → your database → REST API tab)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/refresh. Generate with: openssl rand -hex 32
CRON_SECRET=

# Free API keys — all instant signups
CENSUS_API_KEY=     # https://api.census.gov/data/key_signup.html
HUD_API_TOKEN=      # https://www.huduser.gov/portal/dataset/fmr-api.html
BLS_API_KEY=        # https://data.bls.gov/registrationEngine/
BEA_API_KEY=        # https://apps.bea.gov/API/signup/
EIA_API_KEY=        # https://www.eia.gov/opendata/register.php
